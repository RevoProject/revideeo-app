  "release.title": "What's New",
  "release.understand": "Got it!",
  "release.migration.title": "Playback Stability",
  "release.migration.desc": "Fixed video/audio speed controls and timeline clip overlap on duration changes. Browser preview frame accuracy improved with correct FPS and playbackRate propagation.",
  "release.fixes.title": "Plugin & Auto Captions Fixes",
  "release.fixes.desc": "Auto Captions now correctly discovers media assets when plugins activate before a project loads. Juicer media registration fixed. Missing mobile and plugin translation keys resolved.",
  "release.eupl.title": "Cache & Documentation",
  "release.eupl.desc": "Service worker cache now invalidates correctly across releases. Documentation remastered with canonical API references for Frame, Media, and Timeline APIs.",

  "release.bugfixes.title": "Bug Fixes",
  "release.bugfixes.desc": "Refresh Clip no longer resets the clip — it preserves all timeline edits. Juicer session-scoped attachments: each request only receives the files you attach for that session. Ripple edit: extending a clip now correctly pushes following clips on the same track.",

  "release.juicer-title": "Juicer Timeline Fix",
  "release.juicer-desc": "Fixed Juicer adding clips without pushing following clips forward. Duration increase now triggers ripple edit on the same track. Track names are preserved and not overwritten by filenames.",

